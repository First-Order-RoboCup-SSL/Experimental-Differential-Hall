(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type CONDUCTIVE))
        (layer Inner (type CONDUCTIVE))
        (layer Bottom (type CONDUCTIVE))
        (layer Silk-Top (type SYMBOLMARK))
        (layer Silk-Bottom (type SYMBOLMARK))
        (layer Resist-Top (type SOLDERRESIST))
        (layer Resist-Bottom (type SOLDERRESIST))
        (layer MetalMask-Top (type METALMASK))
        (layer MetalMask-Bottom (type METALMASK))
        (layer CompArea-Top (type COMPAREA))
        (layer CompArea-Bottom (type COMPAREA))
        (layer Top_Assembly (type SYMBOLMARK))
        (layer Bottom_Assembly (type SYMBOLMARK))
        (layer Hole (type HOLE))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip YES)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c112
        (cuser "SamacSys")
        (uuser "SamacSys")
        (ctime 2017-06-16-12:00:00)
        (utime 2017-06-16-12:00:00)
        (photo FLASH)
        (panelUse NO)
        (propertyI padShape 2)
        (propertyI diameter 112000)
        (propertyI originXOffset 0)
        (propertyI originYOffset 0)
      )
      (pad r112_112
        (cuser "SamacSys")
        (uuser "SamacSys")
        (ctime 2017-06-16-12:00:00)
        (utime 2017-06-16-12:00:00)
        (photo FLASH)
        (panelUse NO)
        (propertyI padShape 5)
        (propertyI angle 0)
        (propertyI width 112000)
        (propertyI height 112000)
        (propertyI originXOffset 0)
        (propertyI originYOffset 0)
      )
    ); End of pads
    (padstacks
      (padstack c112h56
        (cuser "SamacSys")
        (uuser "SamacSys")
        (ctime 2017-06-16-12:00:00)
        (utime 2017-06-16-12:00:00)
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 28000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c112))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c112))
        )
        (padSet (footLayer Top)
          (connect (pad c112))
          (noconnect (pad c112))
        )
        (padSet (footLayer Inner)
          (clearance (pad c112))
          (connect (pad c112))
          (noconnect (pad c112))
        )
        (padSet (footLayer Bottom)
          (connect (pad c112))
          (noconnect (pad c112))
        )
      )
      (padstack r112_112h56
        (cuser "SamacSys")
        (uuser "SamacSys")
        (ctime 2017-06-16-12:00:00)
        (utime 2017-06-16-12:00:00)
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 28000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r112_112))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r112_112))
        )
        (padSet (footLayer Top)
          (connect (pad r112_112))
          (noconnect (pad r112_112))
        )
        (padSet (footLayer Inner)
          (clearance (pad r112_112))
          (connect (pad r112_112))
          (noconnect (pad r112_112))
        )
        (padSet (footLayer Bottom)
          (connect (pad r112_112))
          (noconnect (pad r112_112))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "AHE300GPA4B"
        (polarity YES)
        (cuser "SamacSys")
        (uuser "SamacSys")
        (utime 2025-03-29-08:07:57)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Top_Assembly)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 10000 -23000
                        (width 10000)
                      )
                      (pt 290000 -23000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Top_Assembly)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 290000 -23000
                        (width 10000)
                      )
                      (pt 290000 67000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Top_Assembly)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 290000 67000
                        (width 10000)
                      )
                      (pt 10000 67000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Top_Assembly)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 10000 67000
                        (width 10000)
                      )
                      (pt 10000 -23000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 456000 -156000)
                    (pt 456000 276000)
                    (pt -156000 276000)
                    (pt -156000 -156000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -110000 0
                        (width 10000)
                      )
                      (pt -110000 0
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r -5000)
                        (begin
                          (pt -110000 0
                            (width 10000)
                          )
                        )
                        (center 1073741824 0)
                        (end
                          (pt -100000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100000 0
                        (width 10000)
                      )
                      (pt -100000 0
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r -5000)
                        (begin
                          (pt -100000 0
                            (width 10000)
                          )
                        )
                        (center 3221225472 0)
                        (end
                          (pt -110000 0
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack r112_112h56))
                )
              )
            )
          )
          (pin 2
            (pt 100000 120000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 100000 120000)
                  (angle 90)
                  (padstackGroup default (padstack c112h56))
                )
              )
            )
          )
          (pin 3
            (pt 200000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 200000 0)
                  (angle 90)
                  (padstackGroup default (padstack c112h56))
                )
              )
            )
          )
          (pin 4
            (pt 300000 120000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 300000 120000)
                  (angle 90)
                  (padstackGroup default (padstack c112h56))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape AHE300G-PA4-B.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

